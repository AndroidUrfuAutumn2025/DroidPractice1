<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:title="Вторая статья"
            android:navigationIcon="@drawable/arrow_back" />

        <ImageView
            android:id="@+id/imageArticle"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/article2" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Как выжить во время лесного пожара"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="1. Убегайте от лесного пожара вдоль его фронта&#xA;2. По возможности выйдите на участок, свободный от деревьев&#xA;3. Сообщите о пожаре всем, кто встретится на пути."
            android:textSize="18sp" />

        <TextView
            android:id="@+id/text2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:text="Чаще всего лесные пожары провоцируют люди. Неосторожное обращение с огнём, выжигание сухой травы, разбрасывание незатушенных окурков — в жаркую и засушливую погоду любая из этих причин может привести к возгоранию лесной подстилки, кустов, а затем и деревьев."
            android:textSize="16sp"
            android:textStyle="italic" />

        <Switch
            android:id="@+id/readSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Прочитано" />

    </LinearLayout>

</ScrollView>