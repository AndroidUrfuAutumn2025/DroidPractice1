<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тренер «Спартака» Саклич высказался о победе в матче с «Крыльями Советов»"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/subtitleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Реакция главного тренера после победы"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <ImageView
            android:id="@+id/articleImageView"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="@color/purple_200"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/contentTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Главный тренер «Спартака» Гиоргос Саклич после победы над «Крыльями Советов» (3:0) отметил, что команда показала хорошую игру и реализовала свои моменты.\n\n«Мы хорошо подготовились к матчу и знали, что «Крылья» - сильный соперник. Рад, что смогли забить три безответных мяча и контролировали игру на протяжении всего матча», - сказал Саклич.\n\nОн также добавил, что команда будет готовиться к следующим матчам и продолжит работать над улучшением игры."
            android:textSize="16sp"
            android:layout_marginBottom="24dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Switch
                android:id="@+id/readSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Прочитано"/>

        </LinearLayout>

        <Button
            android:id="@+id/backButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вернуться к первой статье"/>

    </LinearLayout>
</ScrollView>