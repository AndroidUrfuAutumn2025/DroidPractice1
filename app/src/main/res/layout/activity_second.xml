<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Makale Görseli -->
    <ImageView
        android:id="@+id/articleImage"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:scaleType="centerCrop"
        android:src="@drawable/futbolcu_adam"
        android:layout_marginBottom="16dp"
        android:contentDescription="Fernando Costanza fotoğrafı" />

    <!-- Makale Başlığı -->
    <TextView
        android:id="@+id/articleTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Makale Başlığı"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Makale İçeriği -->
    <TextView
        android:id="@+id/articleContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Makale içeriği burada yer alacak."
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <!-- Okundu Switch -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <Switch
            android:id="@+id/readSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Okundu olarak işaretle"
            android:layout_marginStart="8dp"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Geri Dön Butonu -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Geri Dön" />

</LinearLayout>